# Caddy reverse proxy for the production compose path (R-2).
#
# TLS is the default production path — there is no profile gate:
#   export DOMAIN=erp.example.com
#   docker compose -f docker-compose.prod.yml up -d --build
#
# {$DOMAIN} comes from the caddy service's environment (compose requires
# DOMAIN — `up` fails loudly without it). Caddy obtains and renews a
# Let's Encrypt certificate automatically; ports 80/443 must be reachable
# and the domain's DNS must point at this server. No HTTP-only fallback:
# if the domain or DNS is wrong, Caddy fails to issue and the site stays
# down rather than silently serving plain HTTP — that is deliberate,
# because production cookies are Secure + __Host- and browsers refuse
# them over HTTP, so an HTTP-only public deploy breaks login outright.
#
# Caddy is exactly ONE hop in front of the app: it appends
# X-Forwarded-For and X-Forwarded-Proto, and the app counts one hop in
# from the right (TRUSTED_PROXY_HOPS=1 in docker-compose.prod.yml).
# Do NOT set CLIENT_IP_HEADER to X-Forwarded-For — src/client_ip.py
# rejects list-valued headers by design.

{$DOMAIN} {
	# The app listens on :8000 inside the compose network; the 8123
	# localhost mapping in docker-compose.prod.yml stays for direct
	# health checks (curl http://127.0.0.1:8123/healthz).
	# m-14: health-aware routing — a hung (not exited) app stops
	# receiving traffic instead of serving 502s/slow responses until
	# someone notices. /readyz proves the DB answers (src/main.py).
	reverse_proxy app:8000 {
		health_uri /readyz
		health_interval 30s
		health_timeout 5s
	}
}
