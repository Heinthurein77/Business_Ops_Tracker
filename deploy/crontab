# Scheduled jobs — Business Ops Tracker (R-6)
#
# Install on the server (phone SSH) with:
#   crontab deploy/crontab
# Verify with:
#   crontab -l
# and record the output in the go-live runbook (§2C). Cron runs with a
# minimal environment: the `cd` + compose file path below are load-bearing,
# and the jobs run INSIDE the running container (`docker compose exec`),
# so they see the container's environment (DATABASE_URL,
# MIGRATION_DATABASE_URL, etc.) as baked in at `docker compose up` time.
# If you change a secret, re-run `up -d` before relying on these jobs.
#
# Heartbeat / dead-man check: the JobHeartbeat mechanism (alert if a job
# has not run in > 36 h) is live — scheduled_alerts upserts its row after
# each run and log_scan (09:00) alerts the Chairman when a row is stale.
# The logs below must still show a fresh line after each scheduled time.
#
# Pm-1 overlap guard: every line below runs under `flock -n` on its own
# lock file, so a second instance never starts while one is still
# running (a slow run is skipped, not duplicated). flock exits 99 only
# on lock conflict (--conflict-exit-code 99, util-linux >= 2.36); any
# other non-zero exit is the job's own failure and is preserved so cron
# still reports it. The skip is logged with a timestamp. New cron lines must follow the same pattern.
#
# Times are server time (Asia/Yangon on the VPS).
#
# Out-of-band alerting (PM-14): cron mails the output of any failing job
# to MAILTO, so a dead backup / dead alerts job is noticed instead of
# living only in ~/bot-*.log on the host. REPLACE the placeholder with
# the Chairman's (or ops) email address BEFORE installing this crontab —
# with the placeholder in place, failure mail goes nowhere. This is the
# minimum: for the machine itself going down, also run a cheap external
# uptime check pinging /healthz (UptimeRobot / Healthchecks — see the
# go-live runbook §2C). Telegram alerting for job failures is an open
# user decision (backlog, not built).
MAILTO=alerts@example.invalid

# --- scheduled_alerts: missing-report reminders + document/batch expiry
# alerts. Daily 08:30. Idempotent (one notification per CEO per run,
# one alert per document per 7 days) — safe to re-run by hand.
# m-19: one retry after a 60 s sleep — if the container is restarting
# (e.g. a deploy window) the first `docker compose exec` fails and that
# day's reminders would otherwise be skipped until the next day.
# Log: ~/bot-alerts.log
30 8 * * * flock -E 99 -n ~/bot-alerts.lock -c 'cd ~/business-ops-tracker && docker compose -f docker-compose.prod.yml exec -T app python -m src.jobs.scheduled_alerts || (sleep 60; docker compose -f docker-compose.prod.yml exec -T app python -m src.jobs.scheduled_alerts)' >> ~/bot-alerts.log 2>&1; rc=$?; if [ $rc -eq 99 ]; then echo "$(date) scheduled_alerts skipped: already running" >> ~/bot-alerts.log; exit 0; else exit $rc; fi

# --- audit_retention: delete sign-in/out rows older than 90 days, clear
# IPs older than 30 days; financial/account rows are KEPT as tamper
# evidence. Weekly, Sunday 03:00. MUST run as the schema-owner role:
# the runtime role (bot_app) deliberately cannot DELETE audit_logs (see
# deploy/db_roles.sql), so running this with the wrong URL fails with
# "permission denied" instead of silently doing nothing — that failure
# in ~/bot-audit-retention.log means MIGRATION_DATABASE_URL was not set
# when the container was started; re-run `up -d` with it set.
# Runs inside the app container, which already has
# MIGRATION_DATABASE_URL from the compose environment.
# Log: ~/bot-audit-retention.log
0 3 * * 0 flock -E 99 -n ~/bot-audit-retention.lock -c 'cd ~/business-ops-tracker && docker compose -f docker-compose.prod.yml exec -T app python -m src.scripts.audit_retention' >> ~/bot-audit-retention.log 2>&1; rc=$?; if [ $rc -eq 99 ]; then echo "$(date) audit_retention skipped: already running" >> ~/bot-audit-retention.log; exit 0; else exit $rc; fi

# --- log_scan: daily count of ERROR / lockout lines in
# the last 24 h of app logs + dead-man check on the JobHeartbeat table
# (alerts the Chairman in-app if a job has not run in > 36 h). Daily
# 09:00. The module reads the logs from stdin, counts the signals, checks
# heartbeat staleness, and exits non-zero when the DB is unreachable.
# This is the minimum-viable monitoring until Sentry/a real alerting path
# exists.
# Log: ~/bot-logscan.log
0 9 * * * flock -E 99 -n ~/bot-logscan.lock -c 'cd ~/business-ops-tracker && docker compose -f docker-compose.prod.yml logs --since 24h app 2>/dev/null | docker compose -f docker-compose.prod.yml exec -T app python -m src.jobs.log_scan' >> ~/bot-logscan.log 2>&1; rc=$?; if [ $rc -eq 99 ]; then echo "$(date) log_scan skipped: already running" >> ~/bot-logscan.log; exit 0; else exit $rc; fi

# --- backup: weekly pg_dump to separate storage (R-4). Weekly, Sunday
# 03:30. BACKUP_DIR must be off the app disk eventually (copy the dumps
# elsewhere); the script keeps 28 days of dumps. Runs on the host (not
# in the container) because it shells out to pg_dump / docker.
# Log: ~/bot-backup.log
30 3 * * 0 flock -E 99 -n ~/bot-backup.lock -c 'cd ~/business-ops-tracker && BACKUP_DIR=~/bot-backups ./scripts/backup.sh' >> ~/bot-backup.log 2>&1; rc=$?; if [ $rc -eq 99 ]; then echo "$(date) backup skipped: already running" >> ~/bot-backup.log; exit 0; else exit $rc; fi
