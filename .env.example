# Copy to .env for local work. In production (Render / DigitalOcean) set these
# as the platform's environment variables instead — .env is never shipped in
# the image (see .dockerignore).

# --- Core ---
# "production" (the default if unset!) turns on the safety checks below, Secure
# cookies, HSTS, and refuses weak configuration. "development" also seeds the
# dev account roster and allows the SQLite + local-upload fallbacks. Anything
# other than production / development / test refuses to start (a typo like
# "prod" must not silently disable the production safeguards).
ENVIRONMENT=production
PORT=8000
APP_TIMEZONE=Asia/Yangon
APP_NAME=Business Operations & CEO Tracking System

# --- Database --- REQUIRED in production (the app refuses to start without it)
# Postgres connection string (e.g. Neon, or DigitalOcean's ${db.DATABASE_URL}).
# Local dev only: leave unset (ENVIRONMENT=development) to fall back to SQLite.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb
# TLS to the database. In production the mode must be require / verify-ca /
# verify-full (default: require). For a provider CA, paste its PEM text into
# DATABASE_CA_CERT and use verify-ca / verify-full so the server's identity is
# checked too. (ALLOW_INSECURE_DATABASE=true exists only for a private, non-TLS
# link you fully control — never for a provider-hosted database.)
# DATABASE_SSLMODE=verify-full
# DATABASE_CA_CERT=
# Least privilege (see deploy/db_roles.sql): run migrations as a schema-owner
# role while the web process uses a restricted one, and apply migrations as a
# release step instead of at web startup.
# MIGRATION_DATABASE_URL=postgresql://bot_migrator:...@host/db
# RUN_MIGRATIONS_ON_STARTUP=false

# --- JWT / Sessions --- REQUIRED in production
# Must be unique, random, and at least 32 characters — the app refuses to
# start in production with this placeholder or anything shorter. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
# Lifetime of a Chairman-issued temporary password before it stops working.
# TEMP_PASSWORD_TTL_HOURS_NEW_ACCOUNT=72
# TEMP_PASSWORD_TTL_HOURS_RESET=24

# --- Data protection --- REQUIRED in production
# Fernet key(s) that encrypt personal data (CEO phone / email / address / date
# of birth, health notes) inside the database. Comma-separated, newest first —
# put a new key in front to rotate, run `python -m src.scripts.rotate_data_key`,
# then drop the old one. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A COPY OUTSIDE THE HOSTING PLATFORM: without a key, those fields cannot
# be recovered. Optional in local development (values are stored unencrypted).
DATA_ENCRYPTION_KEY=

# --- Network edge (production behind a reverse proxy) ---
# Where the real client IP comes from — needed for sign-in throttling and the
# audit log. Set to the platform's own header (DigitalOcean: do-connecting-ip,
# Cloudflare: cf-connecting-ip). If unset, X-Forwarded-For is read TRUSTED_PROXY_HOPS
# entries in from the right (never the left-most one, which a client controls).
# CLIENT_IP_HEADER=do-connecting-ip
# TRUSTED_PROXY_HOPS=1
# Optional pinning (comma-separated). ALLOWED_HOSTS: include localhost and
# 127.0.0.1 if you set it (the container healthcheck uses 127.0.0.1).
# ALLOWED_HOSTS=app.example.com
# ALLOWED_ORIGINS=https://app.example.com
# Content-Security-Policy: enforce (default) | report-only | off
# CSP_MODE=enforce

# --- Cloudflare R2 (file attachments / profile photos) ---
# All three of ACCOUNT_ID / ACCESS_KEY_ID / SECRET_ACCESS_KEY must be set for
# uploads to work. In production with them unset, uploads fail loudly rather
# than writing to the container's ephemeral disk. R2_ENDPOINT_URL may stay
# blank — it's derived from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=business-ops-tracker
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# --- Local dev only ---
# Where uploads land when R2 isn't configured and ENVIRONMENT != production.
# LOCAL_UPLOAD_DIR=./uploads

# --- Business Rules ---
TOTAL_BUSINESS_UNITS=23

# FIRST LOGIN IN PRODUCTION: on first boot the app creates one account,
# "chairman", with a random password printed ONCE to the service's runtime
# logs ("First boot: seeded the 'chairman' account ..."). Sign in with it,
# set your own password when prompted, then create all other accounts from
# User Management. To choose it yourself instead, set BOOTSTRAP_CHAIRMAN_PASSWORD
# as a secret (it is never logged). If the Chairman is ever locked out, run
# `python -m src.scripts.reset_chairman` on the server.
# BOOTSTRAP_CHAIRMAN_PASSWORD=
